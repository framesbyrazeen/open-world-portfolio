# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/dist-pages/
/pages-site/dist-pages/
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
*.tsbuildinfo

# local hosting metadata and generated deployment state
/.openai/
/.sites-runtime/

# personal documents and local credentials
/public/*.pdf
.dev.vars*
*.key
*.crt
credentials.json
credentials*.json
secrets.json
secrets*.json
